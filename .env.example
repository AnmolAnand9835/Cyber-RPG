# Required to start the combined Discord bot and API.
YOUR_BOT_TOKEN=
MONGO_URI=
PORT=3000

# Optional Discord OAuth and browser authentication.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
JWT_SECRET=
CLIENT_REDIRECT_URL=http://localhost:5173/

# Optional comma-separated Discord user IDs permitted to create shop items.
SHOP_ADMIN_DISCORD_IDS=

# Use production for HTTPS deployments and cross-site secure cookies.
NODE_ENV=development
